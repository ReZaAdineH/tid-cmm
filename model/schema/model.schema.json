{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tid-cmm.com/schema/model.schema.json",
  "title": "TID-CMM model",
  "type": "object",
  "required": ["model", "alignment", "levels", "scoring", "domains"],
  "properties": {
    "model": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"const": "TID-CMM"},
        "name": {"type": "string"},
        "short_name": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "released": {"type": "string", "format": "date"},
        "homepage": {"type": "string"},
        "repository": {"type": "string"},
        "contact": {"type": "string"},
        "licence": {"type": "string"},
        "abstract": {"type": "string"}
      }
    },
    "alignment": {
      "type": "object",
      "required": ["attack"],
      "properties": {
        "attack": {
          "type": "object",
          "required": ["framework", "version", "techniques"],
          "properties": {
            "framework": {"type": "string"},
            "version": {"type": "string"},
            "snapshot_date": {"type": "string"},
            "techniques": {"type": "integer", "minimum": 1},
            "parent_techniques": {"type": "integer"},
            "sub_techniques": {"type": "integer"},
            "tactics": {"type": "integer"},
            "data_components": {"type": "integer"}
          }
        },
        "crosswalks": {"type": "array", "items": {"type": "object"}}
      }
    },
    "levels": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["value", "key", "name", "summary", "evidence_bar"],
        "properties": {
          "value": {"type": "integer", "minimum": 0, "maximum": 5},
          "key": {"type": "string"},
          "name": {"type": "string"},
          "summary": {"type": "string"},
          "evidence_bar": {"type": "string"}
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": ["constraints"],
      "properties": {
        "constraints": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "name", "rule"],
            "properties": {
              "id": {"type": "string", "pattern": "^C\\d+$"},
              "name": {"type": "string"},
              "rule": {"type": "string"}
            }
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/domain"}
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "required": ["id", "name", "weight", "subcapabilities"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "name": {"type": "string"},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "intent": {"type": "string"},
        "anti_pattern": {"type": ["string", "null"]},
        "ceiling_rule": {"type": ["string", "null"]},
        "subcapabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/subcapability"}
        }
      }
    },
    "subcapability": {
      "type": "object",
      "required": ["id", "name", "weight", "question", "levels", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{2}\\.\\d+$"},
        "name": {"type": "string"},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "question": {"type": "string", "pattern": "\\?$"},
        "domain_id": {"type": "string"},
        "levels": {
          "type": "object",
          "required": ["0", "1", "2", "3", "4", "5"],
          "additionalProperties": false,
          "patternProperties": {"^[0-5]$": {"type": "string", "minLength": 15}}
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "crosswalk": {
          "type": "object",
          "required": ["nist_csf_2"],
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "attack_link": {"type": ["string", "null"]}
      }
    }
  }
}
